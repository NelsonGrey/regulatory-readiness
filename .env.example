# Copy to .env for local development. All values below target the local
# Docker Compose stack (Postgres + LocalStack) and cost nothing.

NODE_ENV=development

# --- API ---
API_PORT=3000
API_LOG_LEVEL=debug

# --- Database ---
# DATABASE_URL is the owner connection used to run migrations.
DATABASE_URL=postgres://rre:rre@localhost:5432/rre_dev
# APP_DATABASE_URL is the non-superuser runtime connection (RLS is enforced).
# Created by migration 0002; falls back to DATABASE_URL if unset.
APP_DATABASE_URL=postgres://rre_app:rre_app@localhost:5432/rre_dev
# RELAY_DATABASE_URL is the outbox relay connection (BYPASSRLS). Created by 0004.
RELAY_DATABASE_URL=postgres://rre_relay:rre_relay@localhost:5432/rre_dev

# --- AWS / LocalStack ---
AWS_REGION=eu-west-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Object storage (LocalStack S3) ---
S3_BUCKET_ORIGINALS=rre-dev-originals
S3_BUCKET_DERIVATIVES=rre-dev-derivatives
S3_BUCKET_EXPORTS=rre-dev-exports
S3_BUCKET_QUARANTINE=rre-dev-quarantine
S3_BUCKET_INBOUND_EMAIL=rre-dev-inbound-email

# --- Queues (LocalStack SQS) ---
SQS_QUEUE_SCAN=rre-dev-scan
SQS_QUEUE_OCR=rre-dev-ocr
SQS_QUEUE_EXTRACTION=rre-dev-extraction
SQS_QUEUE_EXPORT=rre-dev-export
SQS_QUEUE_NOTIFY=rre-dev-notify
SQS_QUEUE_EVENTS=rre-dev-events
# Full queue URL the outbox relay publishes domain events to.
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/rre-dev-events

# --- Control packs ---
# The pack the local environment activates by default.
ACTIVE_PACK=eaa-accessibility

# --- Public marketing site ---
PUBLIC_SITE_URL=https://readiness.example
PUBLIC_APP_URL=https://app.readiness.example
PUBLIC_SCHEDULER_URL=https://cal.example/readiness-sprint
# Leave both blank to disable analytics. The selected provider must be cookieless.
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SRC=
MARKETING_LEADS_ENDPOINT=
