---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
export async function getStaticPaths() {
  return (await getCollection('legal')).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }))
}
const { entry } = Astro.props as { entry: CollectionEntry<'legal'> }
const { Content } = await render(entry)
const breadcrumbLd = { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[
  { '@type':'ListItem', position:1, name:'Legal', item:new URL('/legal/', Astro.site).href },
  { '@type':'ListItem', position:2, name:entry.data.title, item:Astro.url.href },
] }
---

<BaseLayout title={entry.data.title} description={`${entry.data.title} for the Regulatory Readiness public website.`} jsonLd={breadcrumbLd}>
  <header class="legal-header"><div class="narrow"><p class="eyebrow">Legal</p><h1>{entry.data.title}</h1><p>Last updated <time datetime={entry.data.lastUpdated.toISOString()}>{entry.data.lastUpdated.toLocaleDateString('en-IE', { day:'numeric', month:'long', year:'numeric' })}</time></p></div></header>
  <article class="legal-doc"><div class="narrow prose"><Content /></div></article>
</BaseLayout>
