---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Limitation from '../../components/Limitation.astro'
import CTA from '../../components/CTA.astro'

export async function getStaticPaths() {
  return (await getCollection('packs')).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }))
}
const { entry } = Astro.props as { entry: CollectionEntry<'packs'> }
const { Content } = await render(entry)
const faqLd = entry.data.slug === 'eu-accessibility-act' ? {
  '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'Is this only a checklist?', acceptedAnswer: { '@type': 'Answer', text: 'No. It joins versioned requirements to facts, applicability, evidence locations, decisions, conflicts, and a dated export.' } },
    { '@type': 'Question', name: 'Can an automated extractor approve our documents?', acceptedAnswer: { '@type': 'Answer', text: 'No. Extraction may propose; a person must accept or reject.' } },
    { '@type': 'Question', name: 'Does this replace an accessibility audit or legal adviser?', acceptedAnswer: { '@type': 'Answer', text: 'No. It organizes the evidence record those specialists need.' } },
  ]
} : undefined
const breadcrumbLd = { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[
  { '@type':'ListItem', position:1, name:'Packs', item:new URL('/packs/', Astro.site).href },
  { '@type':'ListItem', position:2, name:entry.data.title, item:Astro.url.href },
] }
---

<BaseLayout title={entry.data.title} description={entry.data.summary} image={entry.data.slug === 'eu-accessibility-act' ? '/og-eaa.svg' : '/og-default.svg'} jsonLd={faqLd ? [breadcrumbLd, faqLd] : breadcrumbLd}>
  <header class="page-header"><div class="shell"><p class="eyebrow">{entry.data.jurisdiction} · {entry.data.regulation}</p><span class:list={['status', entry.data.status === 'available' ? 'status-available' : 'status-roadmap']}>{entry.data.status}</span><h1 style="margin-top:1rem">{entry.data.title}</h1><p class="lead">{entry.data.summary}</p><Limitation /></div></header>
  <article class="article"><div class="narrow prose"><Content /></div></article>
  {entry.data.status === 'available' && <CTA title="Turn the EAA requirements into an owned evidence plan." />}
</BaseLayout>
