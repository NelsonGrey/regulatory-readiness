---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Limitation from '../../components/Limitation.astro'
export async function getStaticPaths() {
  return (await getCollection('posts', ({ data }) => !data.draft)).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }))
}
const { entry } = Astro.props as { entry: CollectionEntry<'posts'> }
const { Content } = await render(entry)
const articleLd = { '@context':'https://schema.org', '@type':'Article', headline:entry.data.title, description:entry.data.summary, datePublished:entry.data.date.toISOString(), author:{ '@type':'Person', name:entry.data.author }, mainEntityOfPage:Astro.url.href }
const breadcrumbLd = { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[
  { '@type':'ListItem', position:1, name:'Deadline briefings', item:new URL('/blog/', Astro.site).href },
  { '@type':'ListItem', position:2, name:entry.data.title, item:Astro.url.href },
] }
---

<BaseLayout title={entry.data.title} description={entry.data.summary} type="article" jsonLd={[breadcrumbLd, articleLd]}>
  <header class="page-header"><div class="narrow"><p class="eyebrow">{entry.data.tags.join(' · ')}</p><h1>{entry.data.title}</h1><p class="lead">{entry.data.summary}</p><p class="article-meta">By {entry.data.author} · <time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString('en-IE', { day:'numeric', month:'long', year:'numeric' })}</time></p><Limitation /></div></header>
  <article class="article"><div class="narrow prose"><Content /><hr/><p><strong>Editorial note:</strong> This briefing is general preparation information, not legal advice. Check primary sources and obtain advice for your circumstances.</p></div></article>
</BaseLayout>
