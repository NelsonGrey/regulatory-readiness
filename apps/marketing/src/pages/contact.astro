---
import BaseLayout from '../layouts/BaseLayout.astro'
import Limitation from '../components/Limitation.astro'
import { siteConfig, signUpUrl } from '../config'
---

<BaseLayout
  title="Contact"
  description="Start a workspace, ask a pre-sales question, report a security issue, or sign in to an existing workspace."
>
  <header class="page-header"><div class="shell"><p class="eyebrow">Contact</p><h1>Most people start without talking to us.</h1><p class="lead">Sign-up is self-serve and the 14-day trial needs no card. Use the routes below if you have a question first, need support, or are reporting something.</p><Limitation /></div></header>
  <section class="section"><div class="shell contact-grid">
    <div class="contact-card">
      <p class="eyebrow">Get started</p>
      <h2>Create a workspace</h2>
      <p>You choose the regulation, the entity boundary, and who contributes. Nothing here loads third-party scheduler or tracking code.</p>
      <a class="button" href={signUpUrl} data-event="start-free">Start free</a>
      <p class="fine-print">Already have a workspace? <a href={siteConfig.appUrl}>Sign in</a>.</p>
    </div>
    <div class="contact-card">
      <h2>Talk to a person</h2>
      <p><strong>Questions before you try it:</strong><br /><a href={`mailto:${siteConfig.contactEmail}?subject=Pre-sales%20question`}>{siteConfig.contactEmail}</a></p>
      <p><strong>Support (existing workspace):</strong><br /><a href={`mailto:${siteConfig.contactEmail}?subject=Support`}>{siteConfig.contactEmail}</a></p>
      <p><strong>Security:</strong><br /><a href={`mailto:${siteConfig.securityEmail}`}>{siteConfig.securityEmail}</a> — do not include customer evidence or active access tokens.</p>
      <p><strong>Press:</strong><br /><a href={`mailto:${siteConfig.pressEmail}`}>{siteConfig.pressEmail}</a></p>
      <p class="fine-print">Purpose: to answer your message. No marketing opt-in is implied. See the <a href="/legal/privacy">privacy notice</a>.</p>
    </div>
  </div></section>
</BaseLayout>
