---
import { signUpUrl } from '../config'
const {
  title = 'Make the true state visible.',
  text = 'Create a workspace, load a pack, and put one entity through the method today.',
} = Astro.props
---

<section class="cta-band" aria-labelledby="cta-title">
  <div>
    <p class="eyebrow">Self-serve, from day one</p>
    <h2 id="cta-title">{title}</h2>
    <p>{text}</p>
  </div>
  <div class="cta-actions">
    <a class="button button-light" href={signUpUrl} data-event="start-free"
      >Start free <span aria-hidden="true">→</span></a
    >
    <a class="button button-secondary" href="/pricing">See pricing</a>
  </div>
</section>
