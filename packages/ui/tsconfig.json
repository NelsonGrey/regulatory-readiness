{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "react"]
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "**/*.test.ts", "**/*.test.tsx"],
  "references": [{ "path": "../domain" }]
}
